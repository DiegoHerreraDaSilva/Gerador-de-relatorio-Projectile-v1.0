# Copie este arquivo para .env e preencha com sua chave real.
# Nunca comite o .env (já está no .gitignore).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Jev (TypeSafe AI) — classifica as perguntas do Chat analítico (aba só de
# gerente) por ~70–500 ms e fração de centavo. Sem a chave o chat continua
# funcionando: o Claude assume a classificação (1 chamada a mais por pergunta).
# ATENÇÃO: com a chave, o texto da pergunta e as listas de clientes e
# colaboradores (opções de escolha) vão para o OpenRouter e/ou a TypeSafe AI.
# Jev (classificador do chat analítico): OpenRouter tem prioridade; sem nenhuma chave, o Claude classifica
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Modelo do Claude no chat analítico (sem thinking); o chat de edição usa ANTHROPIC_MODEL
ANALYTICS_CHAT_MODEL=claude-haiku-4-5-20251001

# Banco MySQL do Projectile (busca de horas direto do banco, sem export manual).
# A senha NÃO vai aqui no fluxo Windows — fica no Windows Credential Manager
# (veja backend/app/db_credentials.py). Em CONTAINER (docker-compose.prod.yml)
# não existe Credential Manager: defina PROJECTILE_DB_PASSWORD no .env (a env
# tem prioridade sobre o keyring, ver db_credentials.py).
PROJECTILE_DB_HOST=
PROJECTILE_DB_PORT=
PROJECTILE_DB_USER=
PROJECTILE_DB_NAME=
PROJECTILE_DB_PASSWORD=

# sysClientId fixo desta instalação Projectile (não deve mudar) — só existe
# como variável pra não ficar hardcoded no código; ver
# backend/app/projectile_db.py e backend/app/core/config.py. Sem essa
# variável (ou vazia), o fallback é "0" (valor de sempre).
PROJECTILE_SYS_CLIENT_ID=0

# Tamanho do pool de conexões pro MySQL do Projectile (backend/app/projectile_db.py).
# Deliberadamente pequeno — banco legado, on-premise, sem staging pra medir
# `max_connections` real do servidor. Sem essa variável (ou vazia), o padrão é 5.
PROJECTILE_DB_POOL_SIZE=5

# Banco MySQL próprio de histórico de relatórios (reports_db, container
# Docker local — ver docker-compose.yml). A senha do usuário do banco NÃO vai
# aqui — fica no Windows Credential Manager, igual ao Projectile (veja
# backend/app/db_credentials.py:get_reports_db_password).
REPORTS_DB_HOST=127.0.0.1
REPORTS_DB_PORT=3307
REPORTS_DB_USER=reports_app
REPORTS_DB_NAME=reports_db
# Em CONTAINER não existe Credential Manager: defina REPORTS_DB_PASSWORD no
# .env (a env tem prioridade sobre o keyring, ver db_credentials.py).
REPORTS_DB_PASSWORD=

# Sessões/rate-limit de login (e a trava de envio da geração automática):
# "memory" (default, dev/testes e NSSM de processo único) ou "redis" (topologia
# de containers — exige REDIS_URL; sem ela o backend falha alto de propósito).
SESSIONS_BACKEND=memory
REDIS_URL=

# Papel do processo: "all" = HTTP + background no mesmo processo (NSSM de
# sempre), "web" = só HTTP, "worker" = só agendador + polling de e-mail (o
# docker-compose.prod.yml seta web/worker por serviço).
PROCESS_ROLE=all

# Base dos links dos avisos por e-mail da geração automática (o app não sabe
# o próprio host) — em produção, o endereço real do app.
APP_BASE_URL=http://localhost:8011

# Build da imagem em rede com inspeção de SSL (proxy corporativo) — vazias por
# padrão; ver README "Produção em containers". O ideal é injetar a CA da empresa.
# PIP_EXTRA_ARGS=--trusted-host pypi.org --trusted-host files.pythonhosted.org
# NPM_CI_ARGS=--strict-ssl=false

# Desliga a persistência de relatórios em reports_db sem precisar reverter
# código/redeploy — útil pra isolar problema de infra do banco novo, ou pra
# validar um deploy antes de ligar a persistência em produção pela primeira
# vez. Sem essa variável (ou vazia), o padrão é "true" (persistência ligada).
REPORTS_DB_ENABLED=true

# Bootstrap ÚNICO do container reports-mysql (docker-compose.yml) — usado só
# na criação do container/schema, nunca lido pela aplicação em runtime. Depois
# de criar o container, guarde a MESMA senha de REPORTS_MYSQL_APP_PASSWORD no
# Credential Manager (veja instrução acima) — daí em diante essa variável só
# importa de novo se o volume do Docker for recriado do zero.
REPORTS_MYSQL_ROOT_PASSWORD=
REPORTS_MYSQL_APP_PASSWORD=

# Logins (separados por vírgula) com acesso ao Painel de Gerência.
# Sem essa variável (ou vazia), o fallback é "dherrera".
MANAGEMENT_PANEL_LOGINS=

# Logins (separados por vírgula) de coordenadores: acessam Gerar relatório
# (inclusive busca por cliente/projeto), Dashboard de horas, o próprio
# Histórico e o Diagnóstico de relatórios — nunca o Painel de Gerência nem o
# Analytics. Gerente não precisa estar aqui (já tem acesso a tudo). Sem essa
# variável (ou vazia), não há coordenador nenhum — sem fallback, de propósito.
COORDINATOR_LOGINS=

# Logins (separados por vírgula) com acesso ao botão "EN" do preview (traduz
# o relatório via IA) — cada clique chama a API da Anthropic, então isso
# limita o gasto a quem realmente precisa. Sem essa variável (ou vazia), o
# fallback é "dherrera".
TRANSLATE_ALLOWED_LOGINS=

# Automação de Horas Faturadas/KPI (Dias) via e-mail (backend/app/email_ingest.py)
# e botão "Enviar Relatório" (POST /send-report). Requer um app registration
# no Azure AD com permissões de APLICAÇÃO:
# - "Mail.Read" (consentimento de admin) sobre a caixa GRAPH_MAILBOX.
# - "Mail.Send" (consentimento de admin) — usada por /send-report pra
#   mandar e-mail "como" o usuário logado (auser.rEmail). Sem uma Exchange
#   Application Access Policy restringindo o escopo, essa permissão deixa o
#   app capaz de mandar e-mail "como" QUALQUER caixa do tenant — recomendado
#   restringir só aos logins que usam esse painel.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAILBOX=
# 1 ou mais e-mails (separados por vírgula) cujas mensagens com anexo são
# processadas — ex: ALBERTO_EMAIL=alberto@empresa.com,outra@empresa.com
ALBERTO_EMAIL=
EMAIL_POLL_INTERVAL_SECONDS=30

# Agendador da geração automática (rodada mensal no dia 1, 06:00 por padrão — o
# dia/hora e o liga/desliga do dia a dia ficam no "Padrão geral" da aba Geração
# automática). Esta variável é só a chave de emergência: false para tudo por fora.
AUTO_GENERATION_ENABLED=true

# Senha da proteção de planilha do relatório final (backend/app/generator.py).
# Sem essa variável (ou vazia), o .xlsx gerado continua protegido/somente
# leitura, mas sem senha — qualquer um desprotege por Revisão > Desproteger
# Planilha. Com uma senha aqui, só quem souber ela consegue desproteger.
# Não é uma senha "forte" de verdade — é a proteção nativa do Excel, que tem
# ferramentas de quebra bem conhecidas — só serve pra frear edição casual.
REPORT_PROTECTION_PASSWORD=

# Observabilidade (ver core/logging.py e README "Observabilidade"). Toda
# resposta HTTP leva um header X-Request-Id e cada linha de log carrega esse
# id; o cliente pode mandar o próprio X-Request-Id (só ids simples são
# aceitos). LOG_FORMAT=json deixa uma linha JSON por evento (pra coletor);
# text (ou vazio) usa o formato legível de sempre. SLOW_REQUEST_MS é o
# limiar em ms do aviso de requisição lenta (0 loga toda requisição, pra
# depuração; negativo desliga o aviso).
LOG_FORMAT=text
SLOW_REQUEST_MS=3000

# DSN do Sentry/GlitchTip self-hosted (o GlitchTip usa o mesmo protocolo).
# Vazio = nenhum erro sai do servidor. SENTRY_ENVIRONMENT identifica o
# ambiente nos eventos (ex: production). PII nunca é enviada (send_default_pii=False).
SENTRY_DSN=
SENTRY_ENVIRONMENT=

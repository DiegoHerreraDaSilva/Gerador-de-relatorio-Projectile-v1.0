# Copie este arquivo para .env e preencha com sua chave real.
# Nunca comite o .env (já está no .gitignore).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Banco MySQL do Projectile (busca de horas direto do banco, sem export manual).
# A senha NÃO vai aqui — fica no Windows Credential Manager (veja backend/app/db_credentials.py).
PROJECTILE_DB_HOST=
PROJECTILE_DB_PORT=3306
PROJECTILE_DB_USER=
PROJECTILE_DB_NAME=projectile

# Logins (separados por vírgula) com acesso ao Painel de Gerência.
# Sem essa variável (ou vazia), o fallback é "dherrera".
MANAGEMENT_PANEL_LOGINS=dherrera

# Automação de Horas Faturadas/KPI (Dias) via e-mail (backend/app/email_ingest.py).
# Requer um app registration no Azure AD com permissão de APLICAÇÃO
# "Mail.Read" (consentimento de admin) sobre a caixa GRAPH_MAILBOX.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAILBOX=agente.reunioes@schwaben.com.br
ALBERTO_EMAIL=
EMAIL_POLL_INTERVAL_SECONDS=30

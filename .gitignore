# Python
__pycache__/
*.pyc
.venv/
venv/

# Claude Code (config/sessão local, não faz parte do projeto)
.claude/

# logs locais de desenvolvimento
*.log

# chave da API da Anthropic — nunca vai pro repo
.env

# override de ambiente do staging em container (segredos locais, não do repo)
.env.staging

# tag da última imagem publicada pelo scripts\atualizar-servidor-docker.bat
.last_image_tag
.last_image_tag.bak

# cópias soltas do logo na raiz — as usadas pelo app ficam em frontend/public
/logo.png
/logo-light.png

# export real do Projectile usado como referência — contém dados reais, não deve ir pro repo
backend/templates/exemplo_projectile.xlsx
templates/exemplo_projectile.xlsx

# Node / Vite (frontend React)
node_modules/
frontend/dist/
frontend/node_modules/
frontend/.vite/
dist/
.vite/
*.tsbuildinfo

# artefatos de sessão do plugin Playwright (screenshots/logs de debug)
.playwright-mcp/

# dados do painel de gerência (KPIs manuais, lista de pacotes não faturáveis)
# — persistência local simples, não faz parte do código do projeto
backend/data/

# saida do Graphify (grafo de conhecimento do codigo, gerado por scripts/atualizar-grafo.bat)
graphify-out/
